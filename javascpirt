// server/routes/books.js
const express = require('express');
const router = express.Router();
const Book = require('../models/Book');

// Abonelik kontrolü ile kitap detayı
router.get('/:id', async (req, res) => {
  try {
    const book = await Book.findById(req.params.id);
    
    // Kullanıcı abone mi kontrolü
    if (book.requiresSubscription && !req.user.subscriptionActive) {
      return res.status(403).json({ error: 'Abonelik gerekiyor' });
    }

    res.json(book);
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

// Kullanıcının abone olduğu kitaplar
router.get('/user/subscribed', async (req, res) => {
  if (!req.user) return res.status(401).send('Yetkisiz erişim');
  
  const books = await Book.find({
    _id: { $in: req.user.subscribedBooks }
  });
  
  res.json(books);
});
