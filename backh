# 1. Proje klasörünü oluştur ve backend dizinine gir
mkdir ebook-backend
cd ebook-backend

# 2. package.json oluştur
npm init -y

# 3. Gerekli paketleri yükle
npm install express mongoose pdfjs-dist cors dotenv jsonwebtoken bcryptjs

# 4. Temel dosyaları oluştur
touch server.js
mkdir models routes config

# 5. MongoDB bağlantısı için .env dosyası oluştur
echo "MONGODB_URI=mongodb://localhost:27017/ebookdb
JWT_SECRET=your_jwt_secret_here
PORT=5000" > .env
